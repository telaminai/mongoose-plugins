<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.telamin</groupId>
        <artifactId>mongoose-plugins</artifactId>
        <version>1.0.21-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>mongoose-test-support</artifactId>
    <name>telamin :: mongoose-plugins :: mongoose-test-support</name>
    <description>
        Test harness for embedding a real MongooseServer in JUnit / TestNG tests.
        Cuts the typical boot/teardown/await ceremony from ~30 lines to ~10.
    </description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- mongoose is inherited as compile from the parent (transitive to consumers).

             We intentionally do NOT pull a junit-jupiter dep here. The harness API
             (MongooseTestHarness) uses zero junit classes — it just throws
             AssertionError on await timeouts. Consumers bring their own junit /
             TestNG / spock, so the test harness composes with any test runner
             without forcing a version. -->

        <!-- Test-scope only: fluxtion-builder is needed by the dynamic-processor
             registration regression test, which compiles a processor at test time
             via Fluxtion.compile(...). Not exposed to consumers. -->
        <dependency>
            <groupId>com.telamin.fluxtion</groupId>
            <artifactId>fluxtion-builder</artifactId>
            <version>${fluxtion.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
