<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.telamin</groupId>
        <artifactId>mongoose-plugins</artifactId>
        <version>1.0.43-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>config-schema-gen</artifactId>
    <name>mongoose-plugins :: tooling :: config-schema-gen</name>
    <description>
        Build-time generator that reflects each connector/service config class's
        JavaBean writable properties into a versioned schema.json describing the
        config surface (types, defaults, enum values). Consumed by the Fluxtion
        Project Starter and published to the docs site. Not a runtime artifact —
        runs at build/release time only. See design/connector-config-schema.md.
    </description>

    <dependencies>
        <!-- The plugins whose config classes we reflect over. Reflection only
             needs them on the classpath (classes are loaded with initialize=false),
             so the heavy transitive runtimes (kafka/aeron/chronicle) are never
             started. Add a plugin here + an entry in plugin-index.json to cover it. -->
        <!-- connectors -->
        <dependency>
            <groupId>com.telamin</groupId>
            <artifactId>connector-file</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.telamin</groupId>
            <artifactId>connector-kafka</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.telamin</groupId>
            <artifactId>connector-aeron</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.telamin</groupId>
            <artifactId>connector-chronicle</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.telamin</groupId>
            <artifactId>connector-multicast</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- services -->
        <dependency>
            <groupId>com.telamin</groupId>
            <artifactId>svc-cache</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.telamin</groupId>
            <artifactId>svc-jdbc</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.telamin</groupId>
            <artifactId>svc-micrometer</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.telamin</groupId>
            <artifactId>svc-admin-telnet</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.telamin</groupId>
            <artifactId>svc-admin-rest</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.telamin</groupId>
            <artifactId>svc-admin-web</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.telamin</groupId>
            <artifactId>svc-loader-yaml</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.telamin</groupId>
            <artifactId>svc-loader-spring</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.telamin</groupId>
            <artifactId>svc-loader-feed</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.telamin</groupId>
            <artifactId>svc-loader-sink</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- JSON read (index/overrides) + write (schema.json). -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- junit-jupiter (test scope) is inherited from the parent pom. -->
    </dependencies>

    <build>
        <plugins>
            <!-- Surface the pinned mongoose version to tests so the version-axis
                 gate (CoreSourceVersionGateTest) can assert the index's core
                 sourceVersion literals match the actual mongoose-core dependency. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <mongoose.version>${mongoose.version}</mongoose.version>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
